{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraquant.local/contracts/kronos-runner/v1/request.schema.json",
  "title": "AstraQuant Kronos zero-shot request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_digest",
    "schema_version",
    "upstream_commit",
    "provider_id",
    "sources",
    "windows_file",
    "folds_digest",
    "rows",
    "input_columns",
    "model",
    "tokenizer",
    "device_policy",
    "seed",
    "context_length",
    "prediction_length",
    "sampling"
  ],
  "properties": {
    "content_digest": { "$ref": "#/$defs/digest" },
    "schema_version": { "const": "astraquant.kronos-request/v1" },
    "upstream_commit": { "const": "67b630e67f6a18c9e9be918d9b4337c960db1e9a" },
    "provider_id": { "const": "eastmoney" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "instrument_id", "source_snapshot_id"],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "instrument_id": { "type": "string", "minLength": 1 },
          "source_snapshot_id": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "windows_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "const": "windows.parquet" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "folds_digest": { "$ref": "#/$defs/digest" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rowIdentity" }
    },
    "input_columns": {
      "const": ["open", "high", "low", "close", "volume", "amount"]
    },
    "model": {
      "$ref": "#/$defs/modelArtifact"
    },
    "tokenizer": {
      "$ref": "#/$defs/tokenizerArtifact"
    },
    "device_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred", "allow_cpu_fallback"],
      "properties": {
        "preferred": { "enum": ["AUTO", "CPU", "CUDA"] },
        "allow_cpu_fallback": { "type": "boolean" }
      }
    },
    "seed": { "type": "integer" },
    "context_length": { "type": "integer", "minimum": 1, "maximum": 512 },
    "prediction_length": { "type": "integer", "minimum": 1 },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "top_k", "top_p", "sample_count"],
      "properties": {
        "temperature": { "type": "number", "exclusiveMinimum": 0 },
        "top_k": { "type": "integer", "minimum": 0 },
        "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "sample_count": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "weights"],
      "properties": {
        "id": { "const": "NeoQuasar/Kronos-base" },
        "revision": { "const": "2b554741eca47781b64468546e77fef3e85130e6" },
        "weights": { "$ref": "#/$defs/weights" }
      }
    },
    "tokenizerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "weights"],
      "properties": {
        "id": { "const": "NeoQuasar/Kronos-Tokenizer-base" },
        "revision": { "const": "0e0117387f39004a9016484a186a908917e22426" },
        "weights": { "$ref": "#/$defs/weights" }
      }
    },
    "rowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fold_id", "row_id", "instrument_id", "decision_time"],
      "properties": {
        "fold_id": { "type": "string", "minLength": 1 },
        "row_id": { "type": "integer", "minimum": 0 },
        "instrument_id": { "type": "string", "minLength": 1 },
        "decision_time": { "type": "string", "minLength": 1 }
      }
    }
  }
}
