{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraquant.local/contracts/research-runner/stage-b-v2-stockmixer-v2-v1/request.schema.json",
  "title": "AstraQuant Stage B v2 StockMixer v2 request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_digest",
    "schema_version",
    "runner_identity",
    "source_materialization_digest",
    "source_raw_export_digest",
    "horizon_sessions",
    "instrument_count",
    "row_count",
    "temporal_panel_file",
    "rows_file",
    "feature_spec",
    "model_config",
    "trials"
  ],
  "properties": {
    "content_digest": { "$ref": "#/$defs/digest" },
    "schema_version": { "const": "astraquant.stage-b-v2-stockmixer-v2-request/v1" },
    "runner_identity": { "$ref": "#/$defs/runner_identity" },
    "source_materialization_digest": { "$ref": "#/$defs/digest" },
    "source_raw_export_digest": { "$ref": "#/$defs/digest" },
    "horizon_sessions": { "enum": [1, 5, 10] },
    "instrument_count": { "type": "integer", "minimum": 1 },
    "row_count": { "type": "integer", "minimum": 1 },
    "temporal_panel_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "row_count"],
      "properties": {
        "path": { "const": "temporal-panel.parquet" },
        "digest": { "$ref": "#/$defs/digest" },
        "row_count": { "type": "integer", "minimum": 1 }
      }
    },
    "rows_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "const": "rows.parquet" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "feature_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookback",
        "temporal_columns",
        "context_columns",
        "price_transform",
        "volume_transform",
        "context_visibility"
      ],
      "properties": {
        "lookback": { "const": 64 },
        "temporal_columns": {
          "const": [
            "open_relative",
            "high_relative",
            "low_relative",
            "close_relative",
            "log_volume_change",
            "log_turnover_change"
          ]
        },
        "context_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "price_transform": { "const": "PREVIOUS_CLOSE_RELATIVE_V1" },
        "volume_transform": { "const": "LOG1P_DIFFERENCE_V1" },
        "context_visibility": { "const": "DECISION_TIME_ONLY" }
      }
    },
    "model_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden_dim",
        "market_dim",
        "context_dim",
        "scales",
        "learning_rate",
        "weight_decay",
        "ranking_weight",
        "epochs",
        "patience",
        "validation_fraction",
        "internal_purge_sessions",
        "session_batch_size",
        "batch_semantics"
      ],
      "properties": {
        "hidden_dim": { "const": 64 },
        "market_dim": { "const": 32 },
        "context_dim": { "const": 32 },
        "scales": { "const": [1, 2, 4] },
        "learning_rate": { "const": "0.001" },
        "weight_decay": { "const": "0.0001" },
        "ranking_weight": { "const": "0.1" },
        "epochs": { "const": 80 },
        "patience": { "const": 8 },
        "validation_fraction": { "const": "0.20" },
        "internal_purge_sessions": { "const": 11 },
        "session_batch_size": { "const": 16 },
        "batch_semantics": { "const": "DECISION_DATE_DYNAMIC_UNIVERSE" }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trial" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runner_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "torch_version", "device"],
      "properties": {
        "package": { "const": "astraquant-stockmixer-runner" },
        "version": { "type": "string", "minLength": 1 },
        "torch_version": { "type": "string", "minLength": 1 },
        "device": { "enum": ["cpu", "cuda"] }
      }
    },
    "row_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "seed",
        "fit_row_ids",
        "inner_valid_row_ids",
        "outer_test_row_ids"
      ],
      "properties": {
        "trial_id": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "fit_row_ids": { "$ref": "#/$defs/row_ids" },
        "inner_valid_row_ids": { "$ref": "#/$defs/row_ids" },
        "outer_test_row_ids": { "$ref": "#/$defs/row_ids" }
      }
    }
  }
}
