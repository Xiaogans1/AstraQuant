{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraquant.local/contracts/research-runner/stage-b-v2-shared-mlp-v1/request.schema.json",
  "title": "AstraQuant Stage B v2 Shared MLP request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_digest",
    "schema_version",
    "runner_identity",
    "source_materialization_digest",
    "feature_columns",
    "row_count",
    "rows_file",
    "model_config",
    "trials"
  ],
  "properties": {
    "content_digest": { "$ref": "#/$defs/digest" },
    "schema_version": { "const": "astraquant.stage-b-v2-shared-mlp-request/v1" },
    "runner_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "torch_version", "device"],
      "properties": {
        "package": { "const": "astraquant-stockmixer-runner" },
        "version": { "type": "string", "minLength": 1 },
        "torch_version": { "type": "string", "minLength": 1 },
        "device": { "enum": ["cpu", "cuda"] }
      }
    },
    "source_materialization_digest": { "$ref": "#/$defs/digest" },
    "feature_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "row_count": { "type": "integer", "minimum": 1 },
    "rows_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "const": "rows.parquet" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "model_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden_dim",
        "market_dim",
        "encoder_layers",
        "dropout",
        "learning_rate",
        "weight_decay",
        "epochs",
        "patience",
        "validation_fraction",
        "internal_purge_sessions",
        "session_batch_size",
        "batch_semantics"
      ],
      "properties": {
        "hidden_dim": { "const": 64 },
        "market_dim": { "const": 32 },
        "encoder_layers": { "const": 2 },
        "dropout": { "const": 0 },
        "learning_rate": { "const": "0.001" },
        "weight_decay": { "const": "0.0001" },
        "epochs": { "const": 80 },
        "patience": { "const": 8 },
        "validation_fraction": { "const": "0.20" },
        "internal_purge_sessions": { "const": 11 },
        "session_batch_size": { "const": 16 },
        "batch_semantics": { "const": "DECISION_DATE_CROSS_SECTION" }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trial" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "row_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "seed",
        "fit_row_ids",
        "inner_valid_row_ids",
        "outer_test_row_ids"
      ],
      "properties": {
        "trial_id": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "fit_row_ids": { "$ref": "#/$defs/row_ids" },
        "inner_valid_row_ids": { "$ref": "#/$defs/row_ids" },
        "outer_test_row_ids": { "$ref": "#/$defs/row_ids" }
      }
    }
  }
}
