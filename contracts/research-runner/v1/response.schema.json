{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraquant.local/contracts/research-runner/v1/response.schema.json",
  "title": "AstraQuant Qlib research response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_content_digest",
    "upstream_commit",
    "model",
    "model_kind",
    "score_semantics",
    "training_task_digest",
    "predictions"
  ],
  "properties": {
    "schema_version": { "const": "astraquant.qlib-response/v1" },
    "request_content_digest": { "$ref": "#/$defs/digest" },
    "upstream_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "model": { "type": "string", "minLength": 1 },
    "model_kind": { "enum": ["LIGHTGBM_BINARY", "DOUBLE_ENSEMBLE"] },
    "score_semantics": { "enum": ["PROBABILITY", "EXPECTED_RETURN"] },
    "training_task_digest": { "$ref": "#/$defs/digest" },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fold_id", "row_id"],
        "properties": {
          "fold_id": { "type": "string", "minLength": 1 },
          "row_id": { "type": "integer", "minimum": 0 },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "score": { "type": "number" }
        },
        "oneOf": [
          { "required": ["probability"] },
          { "required": ["score"] }
        ]
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
